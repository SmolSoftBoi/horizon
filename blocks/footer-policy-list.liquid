{%- doc -%}
  Displays direct links to the store's published policies.
{%- enddoc -%}

{%- capture policy_links -%}
  {%- for policy in shop.policies -%}
    {%- if policy.body != blank and policy.url != blank and policy.title != blank -%}
      <li>
        <a href="{{ policy.url | escape }}">{{ policy.title | escape }}</a>
      </li>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{% if policy_links != blank %}
  <nav
    class="footer-policy-links"
    aria-label="{{ 'content.terms_and_policies' | t | escape }}"
    style="
      {% render 'typography-style', preset: 'custom', settings: block.settings %}
      --color-utilities: {{ block.settings.text_color | default: 'var(--color-foreground)' }};
    "
    {{ block.shopify_attributes }}
  >
    <ul class="footer-policy-links__list list-unstyled" role="list">
      {{ policy_links }}
    </ul>
  </nav>
{% endif %}

{% stylesheet %}
  .footer-policy-links {
    min-inline-size: 0;
    max-inline-size: 100%;
    font-size: var(--font-size, 0.75rem);
    text-transform: var(--text-transform, none);
    text-wrap: wrap;
    overflow-wrap: anywhere;
  }

  .footer-policy-links__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 1.25rem;

    @media screen and (min-width: 750px) {
      justify-content: start;
    }
  }

  .footer-policy-links__list a {
    display: block;
    min-block-size: 24px;
    padding-block: 4px;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.policy_list",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.manage_policies"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "select",
      "id": "font_size",
      "label": "t:settings.size",
      "options": [
        {
          "value": "0.625rem",
          "label": "10px"
        },
        {
          "value": "0.75rem",
          "label": "12px"
        },
        {
          "value": "0.875rem",
          "label": "14px"
        },
        {
          "value": "1rem",
          "label": "16px"
        },
        {
          "value": "1.125rem",
          "label": "18px"
        }
      ],
      "default": "0.75rem"
    },
    {
      "type": "select",
      "id": "case",
      "label": "t:settings.case",
      "options": [
        {
          "value": "none",
          "label": "t:options.default"
        },
        {
          "value": "uppercase",
          "label": "t:options.uppercase"
        }
      ],
      "default": "none"
    }
  ],
  "presets": [
    {
      "name": "t:names.policy_list",
      "category": "t:categories.footer"
    }
  ]
}
{% endschema %}
