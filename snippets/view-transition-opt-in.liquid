{% comment %}
  Opts into cross-document (MPA) view transitions and holds first paint until #MainContent
  parses, so the transition runs consistently. Emitted per-layout because assets/base.css is
  shared and can't read theme settings. Render after the viewport meta tag so the blocker
  uses the correct width on mobile.

  view-transitions.js drops the blocker again whenever no transition can actually run, and
  falls back to dropping it at 1800 ms. It is gated on the same settings (snippets/scripts.liquid).
{% endcomment %}
{% if settings.transition_to_main_product or settings.page_transition_enabled %}
  {% liquid
    assign view_transition_media = '(prefers-reduced-motion: no-preference)'
    if template.name == 'page' and template.suffix == 'about'
      # Keep the Explore link tappable from the first paint on mobile.
      assign view_transition_media = view_transition_media | append: ' and (min-width: 750px)'
    endif
  %}
  {% style %}
    @media {{ view_transition_media }} {
      @view-transition {
        navigation: auto;
      }
    }
  {% endstyle %}
  <link
    rel="expect"
    href="#MainContent"
    blocking="render"
    media="{{ view_transition_media }}"
    id="view-transition-render-blocker"
  >
{% endif %}
