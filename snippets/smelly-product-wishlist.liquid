{% doc %}
  Renders controls or the browser-local wishlist dialog.
  @param {product} [product] - The product to save when rendering a toggle.
  @param {string} section_id - ID of the product or collection section.
  @param {string} placement - Gallery, purchase, card, catalogue, or dialog.
{% enddoc %}

{% capture heart %}
  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
    <path d="M12 20.5 4.3 13a4.9 4.9 0 0 1 7-6.9l.7.7.7-.7a4.9 4.9 0 0 1 7 6.9Z" stroke-linejoin="round"/>
  </svg>
{% endcapture %}

{% if placement == 'dialog' %}
  <smelly-product-wishlist
    id="SmellyProductWishlist-{{ section_id }}{% if product.id != blank %}-{{ product.id }}{% endif %}"
    data-add="{{ 'smelly.product.wishlist_add' | t | escape }}"
    data-remove="{{ 'smelly.product.wishlist_remove' | t | escape }}"
    data-remove-item="{{ 'accessibility.remove_item' | t: title: '[product]' | escape }}"
    data-error="{{ 'smelly.product.wishlist_error' | t | escape }}"
    data-unavailable="{{ 'smelly.product.wishlist_unavailable' | t | escape }}"
  >
    <p class="visually-hidden" role="status" data-wishlist-status></p>
    <dialog id="SmellyWishlist-{{ section_id }}" aria-labelledby="SmellyWishlistTitle-{{ section_id }}" class="smelly-wishlist__dialog">
      <div class="smelly-wishlist__heading">
        <h2 id="SmellyWishlistTitle-{{ section_id }}">{{ 'smelly.product.wishlist' | t }}</h2>
        <form method="dialog">
          <button type="submit" class="button-unstyled smelly-wishlist__close" autofocus aria-label="{{ 'accessibility.close_dialog' | t }}">
            <span class="svg-wrapper" aria-hidden="true">{{ 'icon-close.svg' | inline_asset_content }}</span>
          </button>
        </form>
      </div>
      <p data-wishlist-empty>{{ 'smelly.product.wishlist_empty' | t }}</p>
      <p role="status" data-wishlist-dialog-status></p>
      <ul role="list" data-wishlist-items></ul>
      <template>
        <li>
          <a></a>
          <button type="button" class="button-unstyled" data-wishlist-remove>{{ 'accessibility.remove' | t }}</button>
        </li>
      </template>
    </dialog>
  </smelly-product-wishlist>
{% elsif placement == 'catalogue' %}
  <button type="button" class="button-unstyled smelly-wishlist__open smelly-catalogue__wishlist" aria-haspopup="dialog" aria-controls="SmellyWishlist-{{ section_id }}" data-wishlist-open hidden>
    {{ heart }}
    <span class="visually-hidden">{{ 'smelly.product.wishlist_view' | t }}</span>
  </button>
{% elsif product.id != blank %}
  <button
    type="button"
    class="button-unstyled smelly-wishlist__toggle smelly-wishlist__toggle--{{ placement }}"
    data-wishlist-toggle
    data-product-id="{{ product.id }}"
    data-product-title="{{ product.title | escape }}"
    data-product-url="{{ product.url | escape }}"
    hidden
  >
    {{ heart }}
    <span{% unless placement == 'purchase' %} class="visually-hidden"{% endunless %}>{{ 'smelly.product.wishlist_add' | t }}</span>
  </button>
  {% if placement == 'purchase' %}
    <button type="button" class="button-unstyled smelly-wishlist__open" aria-haspopup="dialog" aria-controls="SmellyWishlist-{{ section_id }}" data-wishlist-open hidden>
      {{ 'smelly.product.wishlist_view' | t }}
    </button>
    <p class="smelly-wishlist__status" role="status" data-wishlist-purchase-status></p>
  {% endif %}
{% endif %}

{% javascript %}
  class SmellyProductWishlist extends HTMLElement {
    static storagePrefix = 'smelly-af:wishlist:';

    connectedCallback() {
      this.container = this.closest('.smelly-product, .smelly-catalogue');
      if (!this.container) return;

      this.dialog = this.querySelector('dialog');
      if (typeof this.dialog?.showModal !== 'function') {
        this.showUnavailable();
        return;
      }

      this.refresh();
      this.listeners = new AbortController();
      const { signal } = this.listeners;
      this.container.addEventListener('click', this.handleClick, { signal });
      window.addEventListener('storage', this.refresh, { signal });
      window.addEventListener('pageshow', this.refresh, { signal });
      window.addEventListener('smelly:wishlist-change', this.refresh, { signal });
    }

    disconnectedCallback() {
      this.listeners?.abort();
    }

    read() {
      return Object.keys(localStorage).flatMap((key) => {
        if (!key.startsWith(SmellyProductWishlist.storagePrefix)) return [];
        try {
          const item = JSON.parse(localStorage.getItem(key));
          if (
            key === SmellyProductWishlist.storagePrefix + item?.id &&
            typeof item.title === 'string' &&
            typeof item.url === 'string' &&
            /^\/(?![/\\])/.test(item.url) &&
            new URL(item.url, location.origin).origin === location.origin
          ) return [item];
        } catch {
          return [];
        }
        return [];
      }).sort((a, b) => a.title.localeCompare(b.title));
    }

    sync(items) {
      const savedIds = new Set(items.map((item) => item.id));
      for (const toggle of this.container.querySelectorAll('[data-wishlist-toggle]')) {
        const saved = savedIds.has(toggle.dataset.productId);
        const label = saved ? this.dataset.remove : this.dataset.add;
        toggle.dataset.saved = String(saved);
        toggle.querySelector('span').textContent = label;
        if (toggle.classList.contains('smelly-wishlist__toggle--card')) {
          toggle.setAttribute('aria-label', `${label} — ${toggle.dataset.productTitle}`);
        }
      }

      if (!this.dialog.open) return;
      const focusedId = this.dialog.querySelector('[data-wishlist-remove]:focus')?.dataset.wishlistRemove;
      const template = this.querySelector('template');
      const list = this.dialog.querySelector('[data-wishlist-items]');
      const entries = items.map((item) => {
        const entry = template.content.cloneNode(true);
        const link = entry.querySelector('a');
        link.textContent = item.title;
        link.href = item.url;
        const removeButton = entry.querySelector('button');
        removeButton.dataset.wishlistRemove = item.id;
        removeButton.setAttribute('aria-label', this.dataset.removeItem.replace('[product]', () => item.title));
        return entry;
      });
      this.dialog.querySelector('[data-wishlist-empty]').hidden = items.length > 0;
      list.replaceChildren(...entries);
      if (focusedId) {
        const removeButtons = [...list.querySelectorAll('button')];
        const focusTarget = removeButtons.find((button) => button.dataset.wishlistRemove === focusedId)
          ?? removeButtons[0]
          ?? this.dialog.querySelector('.smelly-wishlist__close');
        focusTarget.focus();
      }
    }

    refresh = (event) => {
      if (event?.type === 'storage' && event.key !== null && !event.key.startsWith(SmellyProductWishlist.storagePrefix)) return;
      try {
        this.sync(this.read());
        this.setControlsAvailable(true);
        this.reportError('');
      } catch {
        this.showUnavailable();
      }
    };

    setControlsAvailable(available) {
      for (const button of this.container.querySelectorAll('[data-wishlist-toggle], [data-wishlist-open]')) {
        button.hidden = false;
        button.disabled = !available;
      }
    }

    showUnavailable() {
      this.setControlsAvailable(false);
      this.reportError(this.dataset.unavailable);
    }

    handleClick = (event) => {
      if (!(event.target instanceof Element)) return;
      const button = event.target.closest('button');
      if (!button || button.disabled) return;

      if (button.hasAttribute('data-wishlist-open')) {
        this.dialog.showModal();
        this.refresh(event);
        return;
      }

      const toggling = button.hasAttribute('data-wishlist-toggle');
      const id = toggling ? button.dataset.productId : button.dataset.wishlistRemove;
      if (!id) return;

      try {
        const key = SmellyProductWishlist.storagePrefix + id;
        if (toggling && !this.read().some((item) => item.id === id)) {
          localStorage.setItem(key, JSON.stringify({ id, title: button.dataset.productTitle, url: button.dataset.productUrl }));
        } else {
          localStorage.removeItem(key);
        }
        window.dispatchEvent(new Event('smelly:wishlist-change'));
      } catch {
        this.reportError();
      }
    };

    reportError(message = this.dataset.error) {
      const status = this.dialog?.open
        ? this.dialog.querySelector('[data-wishlist-dialog-status]')
        : this.container.querySelector('[data-wishlist-purchase-status]') ?? this.querySelector('[data-wishlist-status]');
      status.textContent = message;
    }
  }

  if (!customElements.get('smelly-product-wishlist')) {
    customElements.define('smelly-product-wishlist', SmellyProductWishlist);
  }
{% endjavascript %}

{% stylesheet %}
  .smelly-wishlist__status {
    margin: 0;
    font-size: 0.875rem;
  }

  .smelly-wishlist__status:not(:empty) {
    margin-block-end: 8px;
  }

  .smelly-wishlist__toggle[hidden],
  .smelly-wishlist__open[hidden] {
    display: none;
  }

  .smelly-wishlist__toggle:not([hidden]) {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    color: var(--smelly-ink);
  }

  .smelly-wishlist__toggle--gallery {
    position: absolute;
    z-index: 2;
    inset-block-start: 12px;
    inset-inline-end: 12px;
    width: 46px;
    border-radius: 50%;
    background: var(--smelly-cream);
  }

  @media screen and (min-width: 750px) {
    .product-information__media:has(slideshow-controls[thumbnails][pagination-position='right']) .smelly-wishlist__toggle--gallery {
      inset-inline: 12px auto;
    }
  }

  .smelly-wishlist__toggle--purchase {
    width: 100%;
    margin-block-start: 12px;
    border: 1px solid var(--smelly-line);
    border-radius: 999px;
    padding-inline: 16px;
    font-weight: 600;
    text-align: center;
  }

  .smelly-wishlist__toggle:hover,
  .smelly-wishlist__toggle[data-saved='true'] {
    border-color: var(--smelly-pink);
    color: var(--smelly-pink);
  }

  .smelly-wishlist__toggle[data-saved='true'] svg {
    fill: currentColor;
  }

  .smelly-wishlist__open {
    min-height: 44px;
    padding-inline: 4px;
    color: var(--smelly-ink);
    font-size: 0.875rem;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .smelly-wishlist__dialog {
    width: min(calc(100% - 32px), 480px);
    max-height: calc(100% - 32px);
    padding: 20px;
    border: 1px solid var(--smelly-line);
    border-radius: 18px;
    background: var(--smelly-cream);
    color: var(--smelly-ink);
  }

  .smelly-wishlist__dialog::backdrop {
    background: rgb(38 26 33 / 48%);
  }

  .smelly-wishlist__heading,
  .smelly-wishlist__dialog li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .smelly-wishlist__heading h2 {
    margin: 0;
    font: 700 1.75rem/1.1 var(--smelly-serif);
  }

  .smelly-wishlist__dialog ul {
    margin: 0;
    padding: 0;
  }

  .smelly-wishlist__dialog li {
    border-block-start: 1px solid var(--smelly-line);
  }

  .smelly-wishlist__dialog li button,
  .smelly-wishlist__dialog li a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .smelly-wishlist__close {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
  }
{% endstylesheet %}
