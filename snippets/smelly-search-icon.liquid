{% doc %}
  Renders a decorative icon for a search result type or suggested link.
  @param {string} icon - Icon name selected in the search section.
{% enddoc %}

<svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" fill="none" aria-hidden="true" focusable="false">
  {% case icon %}
    {% when 'product' %}
      <path d="M3 3h8l10 10-8 8L3 11V3Z"/><circle cx="7.5" cy="7.5" r="1"/>
    {% when 'article' %}
      <path d="M12 5v16m0-16C9 2.5 5.5 2.5 2 4v15c3.5-1.5 7-1.5 10 2 3-3.5 6.5-3.5 10-2V4c-3.5-1.5-7-1.5-10 1Z"/>
    {% when 'collection' %}
      <path d="m2 7 10-4 10 4v10l-10 4-10-4V7Zm0 0 10 4 10-4m-10 4v10"/>
    {% when 'page' %}
      <path d="M5 3h9l5 5v13H5V3Zm9 0v5h5M8 12h8m-8 4h8"/>
    {% when 'calendar' %}
      <rect x="3" y="4.5" width="18" height="16.5" rx="2"/><path d="M7.5 2.5v4m9-4v4M3 9h18"/>
    {% when 'pumpkin' %}
      <path d="M12 7c-2-2-5-2-7 0-2-1-4 2-4 6s2 7 5 7c2 1 4 1 6 0 2 1 4 1 6 0 3 0 5-3 5-7s-2-7-4-6c-2-2-5-2-7 0Zm0 0V3l3-1M6 8c-2 3-2 8 0 11M18 8c2 3 2 8 0 11"/>
    {% when 'tree' %}
      <path d="m12 2 5 7h-3l5 5h-3l5 5h-7v3h-4v-3H3l5-5H5l5-5H7l5-7Z"/>
    {% when 'flame' %}
      <path d="M13 2c1 5 7 7 7 13a8 8 0 1 1-16 0c0-3 2-6 4-8 0 3 1 4 2 4 2-3 3-6 3-9Zm-1 20c3-1 4-4 2-6l-2-3c0 3-3 4-3 6 0 1 1 2 3 3Z"/>
    {% else %}
      <circle cx="10" cy="10" r="6.5"/><path d="m15 15 5 5"/>
  {% endcase %}
</svg>
