{% doc %}
  Renders the text wordmark when a merchant has not uploaded a logo.
{% enddoc %}

<span class="smelly-wordmark">
  <svg class="smelly-wordmark__flame" viewBox="0 0 24 32" width="18" height="24" aria-hidden="true">
    <path fill="currentColor" d="M13 0c2 9 10 12 10 20a11 11 0 0 1-22 0C1 12 8 9 7 4c4 3 3 7 3 7S15 8 13 0Z"/>
    <path fill="var(--smelly-cream, #fff9ef)" d="M13 15c0 5 5 6 5 10a6 6 0 0 1-12 0c0-4 4-6 4-8 2 2 1 5 1 5s3-2 2-7Z"/>
  </svg>
  <span class="smelly-wordmark__name">{{ 'smelly.brand_name' | t }}</span>
  <span class="smelly-wordmark__descriptor">{{ 'smelly.brand_descriptor' | t }}</span>
</span>
