{% doc %}
  Renders a catalogue product using Shopify prices and a native product form.
  @param {product} card_product - The live catalogue product.
  @param {string} section_id - Section identifier for unique form IDs.
  @param {string} [image_sizes] - Responsive image sizes for the section's column count.
  @param {string} [image_loading] - Image loading strategy; defaults to lazy.
  @param {string} [image_priority] - Image fetch priority; defaults to auto.
  @param {string} [product_view_context] - Context for Horizon's standard product view event.
  @param {boolean} [compact_add] - Show an icon on the direct add button.
  @param {boolean} [catalogue_layout] - Show the collection card layout and product summary.
  @param {boolean} [search_layout] - Show the search card with its range badge and labelled basket button.
  @param {boolean} [show_wishlist] - Enable the collection card wishlist toggle.
{% enddoc %}

{% liquid
  assign product_form_id = 'SmellyProduct-' | append: section_id | append: '-' | append: card_product.id
  assign product_variant = card_product.selected_or_first_available_variant
  assign minimum_quantity = product_variant.quantity_rule.min | default: 1
  assign quantity_increment = product_variant.quantity_rule.increment | default: 1 | at_least: 1
  assign cart_quantity = cart | item_count_for_variant: product_variant.id
  assign quantity_to_add = minimum_quantity
  # Include existing basket units when checking increments, maximums and stock.
  # Shopify requires rule minima and maxima to be multiples of the increment.
  assign resulting_quantity = cart_quantity | plus: quantity_to_add
  assign quantity_remainder = resulting_quantity | modulo: quantity_increment
  if quantity_remainder > 0
    assign quantity_adjustment = quantity_increment | minus: quantity_remainder
    assign quantity_to_add = quantity_to_add | plus: quantity_adjustment
    assign resulting_quantity = resulting_quantity | plus: quantity_adjustment
  endif

  assign can_add_to_cart = product_variant.available
  assign add_to_cart_text = 'smelly.add_to_basket' | t
  if product_variant.available == false
    assign add_to_cart_text = 'smelly.sold_out' | t
  elsif product_variant.inventory_management == 'shopify' and product_variant.inventory_policy == 'deny' and resulting_quantity > product_variant.inventory_quantity
    assign can_add_to_cart = false
    assign add_to_cart_text = 'smelly.sold_out' | t
  elsif product_variant.quantity_rule.max != blank and resulting_quantity > product_variant.quantity_rule.max
    assign can_add_to_cart = false
    assign add_to_cart_text = 'products.product.quantity_error_max' | t: maximum: product_variant.quantity_rule.max
  endif

  assign price_variant = product_variant
  if price_variant.price != card_product.price
    assign price_variant = card_product.variants | where: 'price', card_product.price | first
  endif
  assign product_image_alt = card_product.featured_image.alt | default: card_product.title
  assign product_image_sizes = image_sizes | default: '(min-width: 990px) 23vw, 45vw'
  assign product_image_loading = image_loading | default: 'lazy'
  assign product_image_priority = image_priority | default: 'auto'
  assign uses_selling_plans = false
  if card_product.requires_selling_plan or card_product.selling_plan_groups.size > 0
    assign uses_selling_plans = true
  endif
  assign show_card_actions = true
  if search_layout
    assign catalogue_layout = true
    assign range_handles = 'spooky-a-f,festive-a-f,sweet-a-f,fresh-a-f' | split: ','
    for product_collection in card_product.collections
      if range_handles contains product_collection.handle
        assign search_range = product_collection
        break
      endif
    endfor
  endif
  if catalogue_layout
    assign show_card_actions = settings.quick_add
    unless search_layout
      assign description = card_product.description | replace: '</p>', ' ' | strip_html | strip | truncatewords: 24
    endunless
    assign rating = card_product.metafields.reviews.rating.value
    assign review_count = card_product.metafields.reviews.rating_count.value | plus: 0
    if review_count > 0 and rating.rating > 0 and rating.scale_max > 0
      assign rating_fill = rating.rating | times: 100.0 | divided_by: rating.scale_max | at_most: 100
    endif
  endif
%}
{% capture price %}
  <p class="smelly-product-card__price">
    {% if card_product.price_varies %}{{ 'smelly.price_from' | t }} {% endif %}
    {% if settings.currency_code_enabled_product_cards %}{{ card_product.price | money_with_currency }}{% else %}{{ card_product.price | money }}{% endif %}
    {% if price_variant.compare_at_price > card_product.price %}
      <s>{% if settings.currency_code_enabled_product_cards %}{{ price_variant.compare_at_price | money_with_currency }}{% else %}{{ price_variant.compare_at_price | money }}{% endif %}</s>
    {% endif %}
    {% if price_variant.unit_price and price_variant.unit_price_measurement %}
      {% liquid
        assign unit_price = price_variant.unit_price | money
        if settings.currency_code_enabled_product_cards
          assign unit_price = price_variant.unit_price | money_with_currency
        endif
      %}
      {% render 'unit-price', price: unit_price, measurement: price_variant.unit_price_measurement %}
    {% endif %}
  </p>
{% endcapture %}

{% if product_view_context != blank %}
  <product-component class="smelly-product-card__view" view-event-payload="{{ card_product | standard_event_data: 'view', context: product_view_context | escape }}">
{% endif %}
<article class="smelly-product-card{% if catalogue_layout and show_card_actions and settings.mobile_quick_add != true %} smelly-product-card--desktop-quick-add{% endif %}">
  {% if catalogue_layout %}<div class="smelly-product-card__media">{% endif %}
    <a class="smelly-product-card__image" href="{{ card_product.url }}" aria-label="{{ card_product.title | escape }}">
      {% if card_product.featured_image != blank %}
        {{ card_product.featured_image | image_url: width: 1600 | image_tag: widths: '240, 400, 600, 800, 1200, 1600', sizes: product_image_sizes, loading: product_image_loading, fetchpriority: product_image_priority, alt: product_image_alt }}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'smelly-product-card__placeholder' }}
      {% endif %}
      {% unless card_product.available %}<span class="smelly-product-card__badge">{{ 'smelly.sold_out' | t }}</span>{% endunless %}
    </a>
  {% if catalogue_layout %}
      {% if show_wishlist %}
        {% render 'smelly-product-wishlist', product: card_product, section_id: section_id, placement: 'card' %}
      {% endif %}
    </div>
  {% endif %}
  <div class="smelly-product-card__details">
    {% if catalogue_layout %}
      {% if search_layout %}
        <h3><a href="{{ card_product.url }}">{{ card_product.title | escape }}</a></h3>
        {% if search_range != blank %}
          <a class="smelly-product-card__range smelly-product-card__range--{{ search_range.handle | escape }}" href="{{ search_range.url | escape }}">{{ search_range.title | escape }}</a>
        {% endif %}
      {% else %}
        <h2><a href="{{ card_product.url }}">{{ card_product.title | escape }}</a></h2>
      {% endif %}
      {% if description != blank %}
        <p class="smelly-product-card__description">{{ description | escape_once }}</p>
      {% endif %}
      {% if rating_fill != blank %}
        <p class="smelly-product-card__rating">
          <span class="smelly-product-card__stars" style="--rating-fill: {{ rating_fill }}%;" aria-hidden="true">★★★★★<span>★★★★★</span></span>
          <span class="visually-hidden">{{ 'smelly.product.rating' | t: rating: rating.rating, scale: rating.scale_max }}. {{ 'smelly.product.review_count' | t: count: review_count }}</span>
          <span aria-hidden="true">({{ review_count }})</span>
        </p>
      {% endif %}
    {% else %}
      <h3><a href="{{ card_product.url }}">{{ card_product.title | escape }}</a></h3>
      {{ price }}
    {% endif %}
  </div>
  {% if catalogue_layout %}{{ price }}{% endif %}
  {% if show_card_actions and card_product.has_only_default_variant and uses_selling_plans == false %}
    {% form 'product', card_product, id: product_form_id, class: 'smelly-product-form', data-section-id: section_id %}
      <input type="hidden" name="id" value="{{ product_variant.id }}">
      <input type="hidden" name="quantity" value="{{ quantity_to_add }}" data-hydration-key="{{ product_form_id }}-quantity">
      <input type="hidden" name="return_to" value="{{ routes.cart_url }}">
      <button
        data-hydration-key="{{ product_form_id }}-add"
        class="smelly-button smelly-button--small{% if search_layout and can_add_to_cart %} smelly-button--outline{% elsif compact_add and can_add_to_cart %} smelly-product-card__icon-add{% endif %}"
        type="submit"
        {% unless can_add_to_cart %}disabled{% endunless %}
      >
        {% if compact_add and can_add_to_cart %}
          <span class="svg-wrapper" aria-hidden="true">{{ 'icon-add-to-cart.svg' | inline_asset_content }}</span>
          <span class="visually-hidden">{{ add_to_cart_text }} — {{ card_product.title | escape }}</span>
        {% else %}
          {% if search_layout and can_add_to_cart %}<span class="svg-wrapper" aria-hidden="true">{{ 'icon-add-to-cart.svg' | inline_asset_content }}</span>{% endif %}
          {{ add_to_cart_text }}{% if can_add_to_cart %}<span class="visually-hidden"> — {{ card_product.title | escape }}</span>{% endif %}
        {% endif %}
      </button>
      {{ form.errors | default_errors }}
    {% endform %}
  {% elsif show_card_actions %}
    <a class="smelly-button smelly-button--small smelly-button--outline" href="{{ card_product.url }}">{{ 'smelly.choose_options' | t }}<span class="visually-hidden"> — {{ card_product.title | escape }}</span></a>
  {% endif %}
</article>
{% if product_view_context != blank %}</product-component>{% endif %}

{% javascript %}
  let cardRefreshRevision = 0;

  async function refreshCardForms() {
    const revision = ++cardRefreshRevision;
    const sectionIds = new Set();
    for (const form of document.querySelectorAll('.smelly-product-form[data-section-id]')) {
      // These components already refresh their own cards after basket changes.
      if (!form.closest('cart-items-component, product-recommendations[data-refresh-on-cart-update]')) {
        sectionIds.add(form.dataset.sectionId);
      }
    }
    if (!sectionIds.size) return;

    // Liquid calculates inventory, quantity rules and translated labels together.
    // Hydrate only the forms so filters, wishlist controls and keyboard focus stay in place.
    const { buildSectionSelector, sectionRenderer } = await import('@theme/section-renderer');
    await Promise.all(Array.from(sectionIds, async (sectionId) => {
      const section = document.getElementById(buildSectionSelector(sectionId));
      if (!section) return;
      const shouldRender = () =>
        revision === cardRefreshRevision &&
        section.isConnected &&
        !section.querySelector('[data-smelly-submitting="true"]');
      if (!shouldRender()) return;

      const render = () => sectionRenderer.renderSection(sectionId, { cache: false, mode: 'hydration', shouldRender });
      try {
        await render();
      } catch (error) {
        if (error?.name === 'AbortError' || !shouldRender()) return;
        // Retry this section once while the current page and basket revision still match.
        await render();
      }
    }));
  }

  document.addEventListener('shopify:cart:lines-update', (event) => {
    event.promise?.then((result) => {
      if (!result || result.detail?.didError || result.userErrors?.length) return;
      return refreshCardForms();
    }).catch((error) => {
      if (error?.name !== 'AbortError') console.warn('[smelly-product-card] Basket update:', error);
    });
  });

  document.addEventListener('submit', (event) => {
    const form = event.target;
    if (!(form instanceof HTMLFormElement) || !form.matches('.smelly-product-form') || event.defaultPrevented) return;

    if (form.dataset.smellySubmitting === 'true') {
      event.preventDefault();
      return;
    }

    const button = form.querySelector('button[type="submit"]');
    if (!(button instanceof HTMLButtonElement) || button.disabled) {
      event.preventDefault();
      return;
    }

    form.dataset.smellySubmitting = 'true';
    button.disabled = true;
  });

  // History can restore both a submission lock and quantities from before the basket changed.
  window.addEventListener('pageshow', (event) => {
    const navigation = performance.getEntriesByType('navigation')[0];
    if (!event.persisted && navigation?.type !== 'back_forward') return;

    document.querySelectorAll('.smelly-product-form[data-smelly-submitting="true"]').forEach((form) => {
      if (!(form instanceof HTMLFormElement)) return;
      delete form.dataset.smellySubmitting;
      const button = form.querySelector('button[type="submit"]');
      if (button instanceof HTMLButtonElement) button.disabled = false;
    });
    refreshCardForms().catch((error) => {
      if (error?.name !== 'AbortError') console.warn('[smelly-product-card] History restore:', error);
    });
  });
{% endjavascript %}
