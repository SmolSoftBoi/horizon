{% doc %}
  Renders the shared banner and breadcrumbs for Smelly A.F. catalogue pages.
  @param {string} heading - Page heading and current breadcrumb label.
  @param {string} [description_html] - Rich text from the Shopify collection.
  @param {string} [text] - Plain text shown when there is no collection description.
  @param {string} [note] - Handwritten note beside the headline.
  @param {image} [banner_image] - Image to show in place of the bundled banner.
  @param {string} [fallback_banner] - Responsive banner markup for this page when no image is selected.
  @param {string} [parent_url] - Optional intermediate breadcrumb destination.
  @param {string} [parent_label] - Label for the intermediate breadcrumb.
{% enddoc %}

<header class="smelly-catalogue__hero{% if banner_image == blank and fallback_banner == blank %} smelly-catalogue__hero--default{% endif %}">
  {% if banner_image != blank %}
    {{ banner_image | image_url: width: 2400 | image_tag: widths: '480, 750, 1100, 1500, 2000, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', class: 'smelly-catalogue__banner-photo', alt: '' }}
  {% elsif fallback_banner != blank %}
    {{ fallback_banner }}
  {% else %}
    <picture class="smelly-catalogue__banner-photo">
      <source media="(max-width: 1099px)" srcset="{{ 'smelly-collection-hero-small.webp' | asset_url }}">
      <img
        src="{{ 'smelly-collection-hero.webp' | asset_url }}"
        alt=""
        width="2000"
        height="667"
        loading="eager"
        fetchpriority="high"
      >
    </picture>
  {% endif %}
  <div class="smelly-catalogue__hero-inner smelly-catalogue__shell">
    <div class="smelly-catalogue__intro">
      <nav class="smelly-catalogue__breadcrumbs" aria-label="{{ 'smelly.product.breadcrumbs' | t }}">
        <ol role="list">
          <li>
            <a href="{{ routes.root_url | escape }}" aria-label="{{ 'smelly.home' | t }}">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m3 10 9-7 9 7m-16-1v11h5v-6h4v6h5V9"/>
              </svg>
            </a>
          </li>
          {% if parent_url %}
            <li><a href="{{ parent_url | escape }}">{{ parent_label | escape }}</a></li>
          {% endif %}
          <li aria-current="page">{{ heading | escape }}</li>
        </ol>
      </nav>
      <h1>{{ heading | escape }}</h1>
      {% if description_html != blank %}
        <div class="smelly-catalogue__description rte">{{ description_html }}</div>
      {% elsif text != blank %}
        <p class="smelly-catalogue__description">{{ text | escape | newline_to_br }}</p>
      {% endif %}
    </div>
    {% if note != blank %}
      <p class="smelly-catalogue__note smelly-handwritten">
        {{ note | escape | newline_to_br }}
        <span>{% render 'smelly-illustration', kind: 'heart' %}</span>
      </p>
    {% endif %}
  </div>
</header>
