{% doc %}
  Renders the branded password page with Shopify's storefront password form.
  @param {object} [section] - The password section with its background settings. Omit for the layout fallback.
{% enddoc %}

{%- liquid
  assign section_id = section.id | default: 'fallback'
  assign password_id = 'SmellyStorePassword-' | append: section_id
  assign error_id = password_id | append: '-error'
  assign hero_image = ''
  assign hero_video = ''
  assign hero_color = ''
  case section.settings.background_media
    when 'image'
      assign hero_image = section.settings.background_image
    when 'video'
      assign hero_video = section.settings.video
    when 'none'
      assign hero_color = section.settings.background_color
  endcase
-%}

<div
  class="smelly-password{% if hero_color != blank %} smelly-password--solid{% endif %}"
  data-smelly-password-entry="true"
  {% if hero_color != blank %}
    style="--password-hero-background: {{ hero_color | color_to_rgb }};"
  {% endif %}
>
  {%- if hero_video != blank -%}
    <div class="smelly-password__art" aria-hidden="true">
      {% render 'background-media',
        background_media: 'video',
        background_video: hero_video,
        background_video_position: section.settings.video_position,
        section: section
      %}
    </div>
  {%- elsif hero_color == blank -%}
    <picture
      class="smelly-password__art{% if hero_image != blank and section.settings.background_image_position == 'fit' %} smelly-password__art--fit{% endif %}"
      aria-hidden="true"
    >
      {% if hero_image != blank %}
        {{
          hero_image
          | image_url: width: 2400
          | image_tag: widths: '480, 750, 990, 1536, 1920, 2400', sizes: '100vw', alt: '', loading: 'eager', fetchpriority: 'high'
        }}
      {% else %}
        <source media="(max-width: 749px)" srcset="{{ 'smelly-password-hero-small.webp' | asset_url }}">
        <img
          src="{{ 'smelly-password-hero.webp' | asset_url }}"
          width="1536"
          height="800"
          alt=""
          fetchpriority="high"
        >
      {% endif %}
    </picture>
  {%- endif -%}

  <div class="smelly-password__card">
    <span class="smelly-password__badge">
      {% render 'smelly-password-icon', icon: 'lock' %}
    </span>

    <div class="smelly-password__title">
      <h1>{{ 'smelly.password.heading' | t }}</h1>
      <span class="smelly-password__heart">
        {% render 'smelly-password-icon', icon: 'doodle' %}
      </span>
    </div>
    <p class="smelly-password__intro">{{ 'smelly.password.intro' | t: shop: shop.name | escape_once }}</p>
    {% if shop.password_message != blank %}
      <div class="smelly-password__message">{{ shop.password_message }}</div>
    {% endif %}

    {% form 'storefront_password', class: 'smelly-password__form' %}
      <smelly-password-field class="smelly-password__field">
        {% render 'smelly-password-icon', icon: 'lock' %}
        <label for="{{ password_id }}" class="visually-hidden">{{ 'placeholders.password' | t }}</label>
        <input
          id="{{ password_id }}"
          type="password"
          name="password"
          placeholder="{{ 'smelly.password.placeholder' | t | escape }}"
          autocomplete="current-password"
          autocapitalize="off"
          spellcheck="false"
          required
          {% if form.errors %}
            aria-invalid="true"
            aria-describedby="{{ error_id }}"
            autofocus
          {% endif %}
        >
        <button
          class="smelly-password__visibility"
          type="button"
          aria-label="{{ 'smelly.password.show_password' | t | escape }}"
          aria-controls="{{ password_id }}"
          aria-pressed="false"
          hidden
        >
          <span class="smelly-password__eye-closed">
            {% render 'smelly-password-icon', icon: 'eye_closed' %}
          </span>
          <span class="smelly-password__eye-open">
            {% render 'smelly-password-icon', icon: 'eye' %}
          </span>
        </button>
      </smelly-password-field>

      {%- if form.errors -%}
        <p id="{{ error_id }}" class="smelly-password__error" role="alert">{{ 'content.wrong_password' | t }}</p>
      {%- endif -%}

      <button class="smelly-password__submit" type="submit">
        {{ 'smelly.password.enter' | t }}
        <span class="smelly-password__arrow">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
      </button>
    {% endform %}

    {% if shop.email != blank %}
      <p class="smelly-password__help">
        {{ 'smelly.password.need_access' | t }}
        <a href="mailto:{{ shop.email | url_encode | replace: '%40', '@' | escape }}">{{ 'smelly.password.contact' | t }}</a>
      </p>
    {% endif %}
  </div>
</div>

{% javascript %}
  if (!customElements.get('smelly-password-field')) {
    customElements.define(
      'smelly-password-field',
      class extends HTMLElement {
        connectedCallback() {
          const input = this.querySelector('input');
          const toggle = this.querySelector('button');
          if (!input || !toggle) return;

          toggle.onclick = () => {
            const visible = input.type === 'password';
            input.type = visible ? 'text' : 'password';
            toggle.setAttribute('aria-pressed', String(visible));
          };
          toggle.hidden = false;
        }
      }
    );
  }
{% endjavascript %}
