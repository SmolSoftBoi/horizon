{% layout none %}

{%- liquid
  assign formatted_balance = gift_card.balance | money_without_trailing_zeros | strip_html
  assign language = request.locale.iso_code | split: '-' | first
  assign card_status = ''

  if gift_card.expired
    assign card_status = 'gift_cards.issued.expired'
  elsif gift_card.enabled == false
    assign card_status = 'gift_cards.issued.inactive'
  elsif gift_card.balance == 0
    assign card_status = 'gift_cards.issued.empty_balance'
  endif
-%}

<!doctype html>
<html
  lang="{{ request.locale.iso_code }}"
  dir="{{ request.locale.direction | default: 'ltr' }}"
>
  <head>
    <meta charset="utf-8">
    <meta
      name="viewport"
      content="width=device-width,initial-scale=1,viewport-fit=cover"
    >
    <meta
      name="theme-color"
      content="#fff6ef"
    >
    <link
      rel="canonical"
      href="{{ canonical_url }}"
    >

    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    <title>{{ 'gift_cards.issued.title' | t: value: formatted_balance, shop: shop.name | escape }}</title>

    <meta
      name="description"
      content="{{ 'gift_cards.issued.subtext' | t }}"
    >

    {%- render 'stylesheets' -%}
    {{ 'template-giftcard.css' | asset_url | stylesheet_tag }}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-palette' -%}

    {%- if card_status == blank -%}
      <script type="importmap">
        {
          "imports": {
            "@theme/component": "{{ 'component.js' | asset_url }}",
            "@theme/utilities": "{{ 'utilities.js' | asset_url }}",
            "@theme/qr-code-generator": "{{ 'qr-code-generator.js' | asset_url }}"
          }
        }
      </script>
      <script src="{{ 'copy-to-clipboard.js' | asset_url }}" type="module"></script>
      {%- if gift_card.qr_identifier != blank -%}
        <script src="{{ 'qr-code-image.js' | asset_url }}" type="module"></script>
      {%- endif -%}
    {%- endif -%}
    {{ content_for_header }}
  </head>

  <body class="gift-card">
    <main
      class="gift-card__main"
      style="--gift-card-art: url('{{ 'smelly-gift-card-art.webp' | asset_url }}');"
    >
      <header class="gift-card__header">
        {%- if settings.logo != blank -%}
          {%- assign logo_alt = settings.logo.alt | default: shop.name -%}
          {{ settings.logo | image_url: width: 640 | image_tag: class: 'gift-card__logo', alt: logo_alt, loading: 'eager' }}
        {%- else -%}
          {%- render 'smelly-wordmark' -%}
        {%- endif -%}
        <h1 class="gift-card__title">
          {%- if language == 'en' -%}
            <span class="gift-card__title-art">
              <img
                src="{{ 'smelly-gift-card-art.webp' | asset_url }}"
                width="1008"
                height="672"
                alt="{{ 'gift_cards.issued.subtext' | t | escape }}"
                fetchpriority="high"
              >
            </span>
          {%- else -%}
            {{ 'gift_cards.issued.subtext' | t }}
          {%- endif -%}
        </h1>

        <div class="gift-card__balance" style="--balance-length: {{ formatted_balance | size | at_least: 4 }};">
          <svg viewBox="0 0 200 200" fill="currentColor" aria-hidden="true" focusable="false">
            <path d="M76.4 12.1Q100 -10 123.6 12.1Q155 4.7 164.3 35.7Q195.3 45 187.9 76.4Q210 100 187.9 123.6Q195.3 155 164.3 164.3Q155 195.3 123.6 187.9Q100 210 76.4 187.9Q45 195.3 35.7 164.3Q4.7 155 12.1 123.6Q-10 100 12.1 76.4Q4.7 45 35.7 35.7Q45 4.7 76.4 12.1Z"/>
          </svg>
          <p class="gift-card__balance-text">
            <span>{{ 'gift_cards.issued.balance' | t }}</span>
            <bdi>{{ formatted_balance | escape }}</bdi>
          </p>
        </div>
      </header>

      {%- if card_status != blank -%}
        <p class="gift-card__status">{{ card_status | t }}</p>
      {%- else -%}
        <div class="gift-card__panels">
          <section class="gift-card__panel" aria-labelledby="GiftCardOnline">
            <div class="gift-card__panel-intro">
              <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true" focusable="false">
                <path d="M6 33V11a3 3 0 0 1 3-3h30a3 3 0 0 1 3 3v22m-36 0h36l4 5a1.5 1.5 0 0 1-1.25 2.5H3.25A1.5 1.5 0 0 1 2 38l4-5Zm14 4h8"/>
              </svg>
              <div>
                <h2 id="GiftCardOnline">{{ 'gift_cards.issued.use_online' | t }}</h2>
                <p>{{ 'gift_cards.issued.online_instructions' | t }}</p>
              </div>
            </div>

            <copy-to-clipboard-component
              class="gift-card__copy"
              text-to-copy="{{ gift_card.code | escape }}"
              data-copy-success="{{ 'gift_cards.issued.copy_code_success' | t | escape }}"
              data-copy-error="{{ 'gift_cards.issued.copy_code_error' | t | escape }}"
            >
              <div class="gift-card__code-row">
                <bdi class="gift-card__code">{{ gift_card.code | format_code | escape }}</bdi>
                <button
                  class="gift-card__copy-trigger"
                  type="button"
                  ref="copyButton"
                  on:click="/copyToClipboard"
                  aria-label="{{ 'gift_cards.issued.copy_code' | t | escape }}"
                  title="{{ 'gift_cards.issued.copy_code' | t | escape }}"
                  hidden
                >
                  <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true" focusable="false">
                    <path d="M8 7H5a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1v-3M9 3h7l4 4v9a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Zm7 0v5h4"/>
                  </svg>
                </button>
              </div>
              <span class="gift-card__copy-message" ref="copyMessage" role="status"></span>
            </copy-to-clipboard-component>
          </section>

          <section class="gift-card__panel gift-card__panel--store" aria-labelledby="GiftCardStore">
            <div class="gift-card__panel-intro">
              <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true" focusable="false">
                <path d="M7 21v20h34V21M19 41V30h10v11M4 17l5-10h30l5 10a5 5 0 0 1-10 0 5 5 0 0 1-10 0 5 5 0 0 1-10 0 5 5 0 0 1-10 0Zm10 0 3-10m7 10V7m10 10-3-10"/>
              </svg>
              <div>
                <h2 id="GiftCardStore">{{ 'gift_cards.issued.use_in_store' | t }}</h2>
                <p class="gift-card__scan-instructions">{{ 'gift_cards.issued.scan_instructions' | t }}</p>
                <p class="gift-card__scan-fallback">{{ 'gift_cards.issued.in_store_fallback' | t }}</p>
              </div>
            </div>

            {%- if gift_card.qr_identifier != blank -%}
              <qr-code-image
                class="gift-card__qr-code"
                data-identifier="{{ gift_card.qr_identifier | escape }}"
                width="396"
                height="396"
                alt="{{ 'gift_cards.issued.qr_image_alt' | t | escape }}"
              ></qr-code-image>
            {%- endif -%}
          </section>
        </div>
      {%- endif -%}

      {%- if gift_card.expires_on -%}
        {%- assign expires_on_formatted = gift_card.expires_on | date: format: 'abbreviated_date' -%}
        <p class="gift-card__expiry">
          {{ 'gift_cards.issued.expiration_date_html' | t: expires_on: expires_on_formatted }}
        </p>
      {%- endif -%}
    </main>

    <footer class="gift-card__footer">
      {%- if gift_card.pass_url != blank and card_status == blank -%}
        <a href="{{ gift_card.pass_url | escape }}">
          <img
            src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
            width="120"
            height="40"
            alt="{{ 'gift_cards.issued.add_to_apple_wallet' | t | escape }}"
            loading="lazy"
          >
        </a>
      {%- endif -%}
      <a
        href="{{ shop.url | escape }}"
        class="gift-card__shop-link"
        target="_blank"
        rel="noopener"
        aria-describedby="a11y-new-window-message"
      >
        {{ 'gift_cards.issued.shop_link' | t }}
      </a>
    </footer>

    <div hidden>
      <span id="a11y-new-window-message">{{ 'accessibility.new_window' | t }}</span>
    </div>
  </body>
</html>
