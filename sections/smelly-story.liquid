{% assign story_alt = 'smelly.photos.christmas_spice' | t %}
<div class="smelly-story smelly-shell smelly-section-space">
  <div class="smelly-story__photo">
    {% render 'smelly-photo', image: section.settings.image, fallback: 'smelly-christmas-spice.jpg', alt: story_alt %}
    <span class="smelly-story__photo-caption smelly-handwritten">{{ section.settings.caption | escape }}</span>
  </div>
  <div class="smelly-story__copy">
    <p class="smelly-handwritten">{{ section.settings.note | escape }}</p>
    {% if section.settings.main_heading %}<h1>{{ section.settings.heading | escape }}</h1>{% else %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}
    <div class="smelly-story__text">{{ section.settings.text }}</div>
    {% if section.settings.page != blank %}<a class="smelly-button smelly-button--outline" href="{{ section.settings.page.url }}">{{ section.settings.button_label | escape }}<span aria-hidden="true">↗</span></a>{% endif %}
    <div class="smelly-story__signature">{% render 'smelly-illustration', kind: 'heart' %}<span class="smelly-handwritten">{{ section.settings.signature | escape }}</span></div>
  </div>
</div>
{% schema %}
{
  "name": "Smelly A.F. story",
  "tag": "section",
  "class": "smelly-section smelly-story-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "checkbox", "id": "main_heading", "label": "Use as page heading", "default": false },
    { "type": "text", "id": "note", "label": "Handwritten note", "default": "Hello, we’re Smelly A.F." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A little candle. A big A.F. personality." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>We think a good candle should bring a little joy to the everyday. Colourful wax. Scents with character. A name that makes you smile.</p><p>From sweet-shop nostalgia to your favourite time of year, find a little jar that feels like you.</p>" },
    { "type": "image_picker", "id": "image", "label": "Photograph" },
    { "type": "text", "id": "caption", "label": "Photograph caption", "default": "Good scents. Better days." },
    { "type": "page", "id": "page", "label": "Story page" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "A little about us" },
    { "type": "text", "id": "signature", "label": "Signature", "default": "Homes should smell amazing. A.F." }
  ],
  "presets": [{ "name": "Smelly A.F. story" }]
}
{% endschema %}
