{% liquid
  assign testimonial_count = 0
  for block in section.blocks
    assign quote = block.settings.quote | strip
    assign customer_name = block.settings.customer_name | strip
    if quote != blank and customer_name != blank
      assign testimonial_count = testimonial_count | plus: 1
    endif
  endfor
%}

{% if testimonial_count > 0 or request.design_mode %}
  <div
    class="smelly-testimonials smelly-shell smelly-section-space"
    {% if section.settings.heading != blank %}role="region" aria-labelledby="SmellyTestimonialsHeading-{{ section.id }}"{% endif %}
  >
    {% if section.settings.note != blank or section.settings.heading != blank or section.settings.text != blank %}
      <div class="smelly-section-heading smelly-section-heading--centred smelly-testimonials__heading">
        {% if section.settings.note != blank %}
          <p class="smelly-handwritten">{{ section.settings.note | escape }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 id="SmellyTestimonialsHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% if section.settings.text != blank %}
          <p>{{ section.settings.text | escape }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% if request.design_mode %}
      <p class="smelly-editor-note smelly-testimonials__editor-note">{{ 'smelly.editor.testimonials' | t }}</p>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <ul class="smelly-testimonials__grid" role="list">
        {% for block in section.blocks %}
          {% liquid
            assign quote = block.settings.quote | strip
            assign customer_name = block.settings.customer_name | strip
            assign customer_detail = block.settings.detail | strip
            assign rating = block.settings.rating | plus: 0
            assign show_testimonial = false
            if quote != blank and customer_name != blank
              assign show_testimonial = true
            endif
          %}
          {% if show_testimonial or request.design_mode %}
            <li class="smelly-testimonials__item" {{ block.shopify_attributes }}>
              <figure class="smelly-testimonial">
                <div class="smelly-testimonial__marks">
                  <span class="smelly-testimonial__quote-mark" aria-hidden="true">“</span>
                  {% if rating > 0 %}
                    <div class="smelly-testimonial__rating">
                      <span class="visually-hidden">{{ 'smelly.testimonial_rating' | t: rating: rating }}</span>
                      <span class="smelly-testimonial__stars" aria-hidden="true">
                        {%- for star in (1..5) -%}
                          {%- if star <= rating -%}★{%- else -%}☆{%- endif -%}
                        {%- endfor -%}
                      </span>
                    </div>
                  {% endif %}
                </div>
                <blockquote class="smelly-testimonial__quote">
                  <p>
                    {% if quote != blank %}
                      {{ quote | escape | newline_to_br }}
                    {% else %}
                      {{ 'smelly.editor.testimonial_quote' | t }}
                    {% endif %}
                  </p>
                </blockquote>
                <figcaption class="smelly-testimonial__customer">
                  <p class="smelly-testimonial__name">
                    {% if customer_name != blank %}
                      {{ customer_name | escape }}
                    {% else %}
                      {{ 'smelly.editor.testimonial_name' | t }}
                    {% endif %}
                  </p>
                  {% if customer_detail != blank %}
                    <p class="smelly-testimonial__detail">{{ customer_detail | escape }}</p>
                  {% endif %}
                </figcaption>
              </figure>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    {% endif %}
  </div>
{% endif %}

{% schema %}
{
  "name": "Smelly A.F. testimonials",
  "tag": "section",
  "class": "smelly-section smelly-testimonials-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 6,
  "settings": [
    { "type": "paragraph", "content": "Add genuine customer feedback. Each testimonial needs a quote and customer name to appear to shoppers. Empty cards are shown only in the theme editor." },
    { "type": "text", "id": "note", "label": "Handwritten note", "default": "A little love for Smelly A.F." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What our customers say." },
    { "type": "textarea", "id": "text", "label": "Description" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Customer quote" },
        { "type": "text", "id": "customer_name", "label": "Customer name" },
        { "type": "text", "id": "detail", "label": "Customer detail", "info": "Optional context, such as the candle they reviewed." },
        {
          "type": "select",
          "id": "rating",
          "label": "Customer rating",
          "info": "Only choose a rating the customer supplied.",
          "default": "none",
          "options": [
            { "value": "none", "label": "No rating" },
            { "value": "1", "label": "1 star" },
            { "value": "2", "label": "2 stars" },
            { "value": "3", "label": "3 stars" },
            { "value": "4", "label": "4 stars" },
            { "value": "5", "label": "5 stars" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Smelly A.F. testimonials",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
