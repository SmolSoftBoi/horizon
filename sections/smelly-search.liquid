{{ 'smelly-catalogue.css' | asset_url | stylesheet_tag }}
{{ 'smelly-search.css' | asset_url | stylesheet_tag }}

{% liquid
  assign heading = 'content.search' | t
  assign intro = 'smelly.search_page.intro' | t
  assign intro = section.settings.intro | default: intro
  assign query = search.terms | strip
  assign escaped_query = query | escape
  assign all_search_types = 'product,article,page'
  assign search_type = search.types | join: ','
  assign current_result_type = search_type
  if search.types.size == 3
    assign current_result_type = 'all'
  endif
  assign current_sort = search.sort_by | default: search.default_sort_by
  assign encoded_query = query | url_encode
  assign query_url = routes.search_url | append: '?options%5Bprefix%5D=last&q=' | append: encoded_query | append: '&type='
  assign clear_url = query_url | append: search_type | append: '&sort_by=' | append: current_sort
  assign sort_form_id = 'SmellySearchFilters-' | append: section.id
  assign filters = search.filters
  assign show_sort = false
  if search.types contains 'product' and search.sort_options.size > 0
    assign show_sort = true
  endif

  assign active_filter_count = 0
  for filter in filters
    assign active_filter_count = active_filter_count | plus: filter.active_values.size
    if filter.type == 'price_range'
      if filter.min_value.value != blank or filter.max_value.value != blank
        assign active_filter_count = active_filter_count | plus: 1
      endif
    endif
  endfor

  assign result_types = 'all,product,article,page,collection' | split: ','
  assign product_image_sizes = '(min-width: 1600px) 225px, (min-width: 1440px) 15vw, (min-width: 1200px) 19vw, (min-width: 990px) 23vw, (min-width: 750px) 31vw, 46vw'
%}

{% capture recommendations %}
  {% for block in section.blocks %}
    {% liquid
      assign recommended_collection = block.settings.collection
      assign recommendation_label = block.settings.heading | default: recommended_collection.title
      assign recommendation_url = recommended_collection.url
      if recommendation_url == blank and block.settings.search_term != blank
        assign recommendation_query = block.settings.search_term | strip | url_encode
        assign recommendation_url = routes.search_url | append: '?type=product&options%5Bprefix%5D=last&q=' | append: recommendation_query
      endif
    %}
    {% if recommendation_label != blank and recommendation_url != blank %}
      <li {{ block.shopify_attributes }}>
        <a href="{{ recommendation_url | escape }}">
          {% render 'smelly-search-icon', icon: block.settings.icon %}
          <span>{{ recommendation_label | escape }}</span>
          {{- 'icon-chevron-right.svg' | inline_asset_content -}}
        </a>
      </li>
    {% endif %}
  {% endfor %}
{% endcapture %}

<div class="smelly-section smelly-search">
  <header class="smelly-search__hero">
    {% if section.settings.banner_image != blank %}
      {{ section.settings.banner_image | image_url: width: 2400 | image_tag: widths: '480, 750, 1100, 1500, 2000, 2400', sizes: '100vw', class: 'smelly-search__banner', loading: 'eager', fetchpriority: 'high', alt: '' }}
    {% else %}
      <picture class="smelly-search__banner smelly-search__banner--bundled">
        <source media="(max-width: 1300px)" srcset="{{ 'smelly-collection-hero-small.webp' | asset_url }}">
        <img src="{{ 'smelly-collection-hero.webp' | asset_url }}" width="2000" height="667" loading="eager" fetchpriority="high" alt="">
      </picture>
    {% endif %}

    <div class="smelly-search__hero-inner">
      <div class="smelly-search__intro">
        <nav aria-label="{{ 'smelly.product.breadcrumbs' | t }}">
          <ol class="smelly-search__breadcrumbs" role="list">
            <li><a href="{{ routes.root_url | escape }}" aria-label="{{ 'smelly.home' | t }}">{% render 'smelly-contact-icon', icon: 'home' %}</a></li>
            <li aria-current="page">{{ heading }}</li>
          </ol>
        </nav>
        <h1>{{ heading }} <span class="smelly-search__heart">{% render 'smelly-illustration', kind: 'heart' %}</span></h1>
        <p>{{ intro | escape }}</p>
      </div>

      <form class="smelly-search__form" action="{{ routes.search_url | escape }}" method="get" role="search" aria-label="{{ 'content.search_input_label' | t }}">
        {% if search.performed and search_type != blank %}
          <input type="hidden" name="type" value="{{ search_type | escape }}">
        {% endif %}
        <input type="hidden" name="options[prefix]" value="last">
        <div class="smelly-search__field">
          {{- 'icon-search.svg' | inline_asset_content -}}
          <label class="visually-hidden" for="SmellySearchQuery-{{ section.id }}">{{ 'content.search_input_label' | t }}</label>
          <input id="SmellySearchQuery-{{ section.id }}" type="search" name="q" value="{{ escaped_query }}" placeholder="{{ 'smelly.search_scents' | t }}" required>
          <a class="smelly-search__reset" href="{{ routes.search_url | escape }}" aria-label="{{ 'accessibility.reset_search' | t }}">
            {{- 'icon-close.svg' | inline_asset_content -}}
          </a>
        </div>
        <button class="smelly-button" type="submit">{{ heading }}</button>
      </form>
    </div>
  </header>

  <div class="smelly-search__shell">
    {% if search.performed and query != blank %}
      <smelly-search-results
        class="smelly-catalogue__browse smelly-search__layout{% if filters.size > 0 %} smelly-search__layout--facets{% endif %}"
        data-collections-url="{{ routes.predictive_search_url | escape }}"
        data-query="{{ escaped_query }}"
      >
        {% render 'skip-to-content-link', href: '#SearchResults', text: 'accessibility.skip_to_results_list' %}
        <div class="smelly-search__toolbar">
          <h2>{{ 'smelly.search_page.results_for' | t: query: escaped_query }} <span class="smelly-search__heart">{% render 'smelly-illustration', kind: 'heart' %}</span></h2>
          <nav class="smelly-search__types" aria-label="{{ 'content.search_results_label' | t }}">
            {% for result_type in result_types %}
              {% liquid
                case result_type
                  when 'product'
                    assign type_label = 'content.search_results_resource_products' | t
                  when 'article'
                    assign type_label = 'smelly.search_page.articles' | t
                  when 'collection'
                    assign type_label = 'content.search_results_resource_collections' | t
                  when 'page'
                    assign type_label = 'content.search_results_resource_pages' | t
                  else
                    assign type_label = 'smelly.search_page.all' | t
                endcase
                assign type_url = query_url | append: result_type
                if result_type == 'all'
                  assign type_url = query_url | append: all_search_types
                elsif result_type == 'collection'
                  assign type_url = routes.collections_url
                endif
                assign is_current = false
                if result_type == current_result_type
                  assign is_current = true
                endif
              %}
              <a href="{{ type_url | escape }}"{% if is_current %} aria-current="page" data-native-tab{% endif %}{% if result_type == 'collection' %} data-collections-tab{% endif %}>
                {% render 'smelly-search-icon', icon: result_type %}
                <span>{{ type_label }}{% if is_current %} ({{ search.results_count }}){% endif %}{% if result_type == 'collection' %}<span data-collection-tab-count></span>{% endif %}</span>
              </a>
            {% endfor %}
          </nav>

          {% liquid
            assign count_label = 'smelly.search_page.result_count'
            if search_type == 'product'
              assign count_label = 'smelly.search_page.product_count'
            elsif search_type == 'article'
              assign count_label = 'smelly.search_page.article_count'
            endif
          %}
          <p class="smelly-search__count" data-native-search>{{ count_label | t: count: search.results_count }}</p>
          {% if show_sort or filters.size > 0 %}
            <div class="smelly-search__tools" data-native-search>
              {% if filters.size > 0 %}
                <input class="smelly-catalogue__filter-toggle smelly-search__filter-toggle" id="SmellySearchFilterToggle-{{ section.id }}" type="checkbox" aria-controls="{{ sort_form_id }}">
                <label class="smelly-search__filter-label" for="SmellySearchFilterToggle-{{ section.id }}">
                  {{- 'icon-filter.svg' | inline_asset_content -}}
                  {{ 'content.filters' | t }}{% if active_filter_count > 0 %} ({{ active_filter_count }}){% endif %}
                </label>
              {% endif %}
              {% if show_sort %}
                <div class="smelly-search__sort">
                  <label for="SmellySearchSort-{{ section.id }}">{{ 'smelly.search_page.sort_by' | t }}</label>
                  <select id="SmellySearchSort-{{ section.id }}" form="{{ sort_form_id }}" name="sort_by" data-search-sort>
                    {% for option in search.sort_options %}
                      <option value="{{ option.value | escape }}"{% if option.value == current_sort %} selected{% endif %}>{{ option.name | escape }}</option>
                    {% endfor %}
                  </select>
                  <button type="submit" class="smelly-search__sort-apply" form="{{ sort_form_id }}">{{ 'actions.apply' | t }}</button>
                </div>
              {% endif %}
            </div>
          {% endif %}
        </div>

        {% if show_sort or filters.size > 0 %}
          <form id="{{ sort_form_id }}" class="smelly-search__facets" action="{{ routes.search_url | escape }}" method="get" aria-label="{{ 'accessibility.filters' | t }}" data-native-search{% if filters.size == 0 %} hidden{% endif %}>
            <input type="hidden" name="q" value="{{ escaped_query }}">
            <input type="hidden" name="type" value="{{ search_type | escape }}">
            <input type="hidden" name="options[prefix]" value="last">
            {% if filters.size > 0 %}
              {% unless show_sort %}<input type="hidden" name="sort_by" value="{{ current_sort | escape }}">{% endunless %}
              {% render 'smelly-search-filters', filters: filters, clear_url: clear_url, active_filter_count: active_filter_count %}
            {% endif %}
          </form>
        {% endif %}

        <div class="smelly-search__results" id="SearchResults" data-native-search tabindex="-1">
          {% if search.results_count > 0 %}
            {% paginate search.results by 20 %}
              <ul class="smelly-search__grid" role="list">
                {% for item in search.results %}
                  <li>
                    {% if item.object_type == 'product' %}
                      {% render 'smelly-product-card', card_product: item, section_id: section.id, image_sizes: product_image_sizes, product_view_context: 'search', search_layout: true %}
                    {% else %}
                      <a class="smelly-search__resource" href="{{ item.url | escape }}">
                        {% if item.image != blank %}
                          {{ item.image | image_url: width: 640 | image_tag: widths: '240, 400, 640', sizes: product_image_sizes, loading: 'lazy', alt: '' }}
                        {% endif %}
                        <h3>{{ item.title | escape }}</h3>
                      </a>
                    {% endif %}
                  </li>
                {% endfor %}
              </ul>
              {% render 'pagination-controls', paginate: paginate %}
            {% endpaginate %}
          {% else %}
            <div class="smelly-search__empty">
              <p>{{ 'content.search_results_no_results' | t: terms: escaped_query }}</p>
              {% if active_filter_count > 0 %}
                <a class="smelly-text-link" href="{{ clear_url | escape }}">{{ 'actions.clear_all' | t }}</a>
              {% endif %}
            </div>
          {% endif %}
        </div>

        <div class="smelly-search__results" id="SearchCollections" data-collections-panel tabindex="-1" hidden>
          <p class="smelly-search__collection-status" role="status" data-collections-status></p>
          <ul class="smelly-search__grid" role="list" data-collections-grid hidden></ul>
          <a class="smelly-text-link" href="{{ routes.collections_url | escape }}">{{ 'smelly.search_page.browse_collections' | t }}</a>
        </div>

        <template data-collection-card>
          <li>
            <a class="smelly-search__resource">
              <img alt="" width="400" height="400" loading="lazy" hidden>
              <h3></h3>
            </a>
          </li>
        </template>
        <template data-collections-messages>
          <span data-loading>{{ 'smelly.search_page.loading_collections' | t }}</span>
          <span data-empty>{{ 'smelly.search_page.no_collections' | t }}</span>
          <span data-error>{{ 'smelly.search_page.collections_unavailable' | t }}</span>
          <span data-count>{{ 'smelly.search_page.collections_shown' | t: count: '[count]' }}</span>
        </template>
      </smelly-search-results>
      <script src="{{ 'smelly-search.js' | asset_url }}" type="module"></script>
    {% else %}
      {% assign suggested_products = settings.empty_state_collection | default: collections.all %}
      {% if suggested_products.products.size > 0 %}
        <div class="smelly-search__suggestions">
          <h2>{{ 'smelly.search_page.browse_candles' | t }}</h2>
          <ul class="smelly-search__grid" role="list">
            {% for item in suggested_products.products limit: 5 %}
              <li>{% render 'smelly-product-card', card_product: item, section_id: section.id, image_sizes: product_image_sizes, search_layout: true %}</li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}
    {% endif %}

    {% if recommendations != blank %}
      <nav class="smelly-search__recommendations" aria-labelledby="SmellySearchRecommendations-{{ section.id }}">
        <h2 id="SmellySearchRecommendations-{{ section.id }}">{{ 'smelly.search_page.recommendations' | t }} <span class="smelly-search__heart">{% render 'smelly-illustration', kind: 'heart' %}</span></h2>
        <ul role="list">{{ recommendations }}</ul>
      </nav>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Smelly A.F. search",
  "settings": [
    { "type": "image_picker", "id": "banner_image", "label": "Banner image" },
    { "type": "text", "id": "intro", "label": "Banner introduction" }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "recommendation",
      "name": "Suggested search or range",
      "settings": [
        { "type": "text", "id": "heading", "label": "Link label" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "search_term", "label": "Search term", "info": "Used when a collection is unavailable." },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "calendar", "label": "Calendar" },
            { "value": "pumpkin", "label": "Pumpkin" },
            { "value": "tree", "label": "Fir tree" },
            { "value": "flame", "label": "Flame" }
          ],
          "default": "flame"
        }
      ]
    }
  ]
}
{% endschema %}
