<div class="smelly-faq smelly-shell smelly-section-space">
  <div><p class="smelly-handwritten">{{ section.settings.note | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div>
  <div class="smelly-faq__items">
    {% for block in section.blocks %}
      <details class="smelly-faq__item" {{ block.shopify_attributes }}><summary>{{ block.settings.question | escape }}<span aria-hidden="true">+</span></summary><div>{{ block.settings.answer }}</div></details>
    {% endfor %}
  </div>
</div>
{% schema %}
{
  "name": "Smelly A.F. questions",
  "tag": "section",
  "class": "smelly-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "note", "label": "Handwritten note", "default": "A little candle know-how" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Curious A.F.?" }
  ],
  "blocks": [{ "type": "question", "name": "Question", "settings": [
    { "type": "text", "id": "question", "label": "Question", "default": "How do I choose a scent?" },
    { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Start with a mood: Sweet A.F., Fresh A.F., Spooky A.F. or Festive A.F. Check each product’s description for its scent details.</p>" }
  ] }],
  "presets": [{ "name": "Smelly A.F. questions", "blocks": [
    { "type": "question" },
    { "type": "question", "settings": { "question": "Where can I find candle care information?", "answer": "<p>Read the care and safety information supplied with your candle, and check its product page for any additional instructions. Always remove the lid before lighting.</p>" } }
  ] }]
}
{% endschema %}
