{% comment %}Keep blank blocks selectable in the editor without leaving gaps for shoppers.{% endcomment %}
{% liquid
  assign detail_count = 0
  for block in section.blocks
    if block.settings.heading != blank or block.settings.text != blank or request.design_mode
      assign detail_count = detail_count | plus: 1
    endif
  endfor
%}

{% if detail_count > 0 %}
  <ul class="smelly-benefits smelly-shell" role="list" style="--smelly-benefits-columns: {{ detail_count }};">
    {% for block in section.blocks %}
      {% if block.settings.heading != blank or block.settings.text != blank or request.design_mode %}
        <li class="smelly-benefits__item" {{ block.shopify_attributes }}>
          <span class="smelly-benefits__icon" aria-hidden="true">
            {% render 'smelly-illustration', kind: block.settings.icon %}
          </span>
          <div class="smelly-benefits__copy">
            {% if block.settings.heading != blank %}
              <p class="smelly-benefits__heading">{{ block.settings.heading | escape }}</p>
            {% endif %}
            {% if block.settings.text != blank %}
              <p class="smelly-benefits__text">{{ block.settings.text | escape }}</p>
            {% endif %}
          </div>
        </li>
      {% endif %}
    {% endfor %}
  </ul>
{% endif %}
{% schema %}
{
  "name": "Smelly A.F. details",
  "tag": "section",
  "class": "smelly-section smelly-benefits-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 4,
  "blocks": [{
    "type": "detail", "name": "Detail",
    "settings": [
      {
        "type": "select",
        "id": "icon",
        "label": "Illustration",
        "options": [
          { "value": "pour", "label": "Pouring jug" },
          { "value": "soy", "label": "Soy sprig" },
          { "value": "jar", "label": "Candle jar" },
          { "value": "heart", "label": "Heart" },
          { "value": "flower", "label": "Flower" },
          { "value": "candy", "label": "Sweet" }
        ],
        "default": "pour"
      },
      { "type": "text", "id": "heading", "label": "Heading", "default": "Hand-poured" },
      { "type": "text", "id": "text", "label": "Text", "default": "A personal touch in every jar" }
    ]
  }],
  "presets": [{ "name": "Smelly A.F. details", "blocks": [
    { "type": "detail", "settings": { "icon": "pour", "heading": "Hand-poured", "text": "A personal touch in every jar" } },
    { "type": "detail", "settings": { "icon": "soy", "heading": "Soy wax candles", "text": "Colourful wax. Characterful scents." } },
    { "type": "detail", "settings": { "icon": "jar", "heading": "150g of personality", "text": "Your shelf’s new favourite" } }
  ] }]
}
{% endschema %}
