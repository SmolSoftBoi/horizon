<div class="smelly-benefits smelly-shell">
  {% for block in section.blocks %}
    <div class="smelly-benefits__item" {{ block.shopify_attributes }}>
      <span class="smelly-benefits__icon" aria-hidden="true">{% render 'smelly-illustration', kind: block.settings.icon %}</span>
      <div><p>{{ block.settings.heading | escape }}</p><span>{{ block.settings.text | escape }}</span></div>
    </div>
  {% endfor %}
</div>
{% schema %}
{
  "name": "Smelly A.F. details",
  "tag": "section",
  "class": "smelly-section smelly-benefits-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 4,
  "blocks": [{
    "type": "detail", "name": "Detail",
    "settings": [
      { "type": "select", "id": "icon", "label": "Illustration", "options": [{ "value": "heart", "label": "Heart" }, { "value": "flower", "label": "Flower" }, { "value": "candy", "label": "Sweet" }], "default": "heart" },
      { "type": "text", "id": "heading", "label": "Heading", "default": "Hand-poured" },
      { "type": "text", "id": "text", "label": "Text", "default": "A personal touch in every jar" }
    ]
  }],
  "presets": [{ "name": "Smelly A.F. details", "blocks": [
    { "type": "detail", "settings": { "icon": "heart", "heading": "Hand-poured", "text": "A personal touch in every jar" } },
    { "type": "detail", "settings": { "icon": "flower", "heading": "Soy wax candles", "text": "Colourful wax. Characterful scents." } },
    { "type": "detail", "settings": { "icon": "candy", "heading": "150g of personality", "text": "Your shelf’s new favourite" } }
  ] }]
}
{% endschema %}
