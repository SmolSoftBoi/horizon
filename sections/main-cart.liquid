{% liquid
  assign custom_color = false
  if section.settings.background_color != blank or section.settings.text_color != blank
    assign custom_color = true
    render 'contrast-override', background_color: section.settings.background_color, text_color: section.settings.text_color, section_id: section.id
  endif
  assign cart_context = nil
  assign basket_title = nil
  if settings.smelly_branding
    assign cart_context = 'basket'
    assign basket_title = 'smelly.basket.title' | t
  endif
%}

{% capture cart_page_title %}
  {%- content_for 'block', id: 'cart-page-title', type: '_cart-title', basket_title: basket_title -%}
{% endcapture %}

{{ 'smelly-basket.css' | asset_url | stylesheet_tag }}

{%- if settings.smelly_branding -%}
  <header class="smelly-basket__banner">
    <picture class="smelly-basket__photo">
      <source media="(max-width: 1099px)" srcset="{{ 'smelly-collection-hero-small.webp' | asset_url }}">
      <img src="{{ 'smelly-collection-hero.webp' | asset_url }}" alt="" width="2000" height="667" fetchpriority="high">
    </picture>
    <div class="smelly-basket__banner-inner">
      <div>
        <nav class="smelly-basket__breadcrumbs" aria-label="{{ 'smelly.product.breadcrumbs' | t }}">
          <ol class="list-unstyled" role="list">
            <li>
              <a href="{{ routes.root_url }}" aria-label="{{ 'smelly.home' | t }}">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m3 10 9-7 9 7m-16-1v11h5v-6h4v6h5V9"/>
                </svg>
              </a>
            </li>
            <li aria-hidden="true">{{ 'icon-chevron-right.svg' | inline_asset_content }}</li>
            <li aria-current="page">{{ basket_title }}</li>
          </ol>
        </nav>
        {{ cart_page_title }}
        <p class="smelly-basket__intro">{{ 'smelly.basket.intro' | t }}</p>
      </div>
      <p class="smelly-basket__note smelly-handwritten">{{ 'smelly.basket.banner_note' | t }}</p>
    </div>
  </header>
  {%- if section.settings.show_wishlist -%}
    {% render 'smelly-product-wishlist', section_id: section.id, placement: 'dialog' %}
  {%- endif -%}
{%- endif -%}

{% capture cart_page_more_blocks_content %}
  <div class="cart-page__more-blocks">
    {%- content_for 'blocks' -%}
  </div>
{% endcapture %}

{% capture cart_items_children %}
  <template id="empty-cart-template">
    <div class="section-background{% if custom_color %} color-custom-{{ section.id }}{% endif %}"></div>
    <div
      class="section{% if custom_color %} color-custom-{{ section.id }}{% endif %} section--{{ section.settings.section_width }}"
    >
      <div
        class="cart-page spacing-style cart-page--empty"
        style="{% render 'spacing-style', settings: section.settings %}"
      >
        {%- unless settings.smelly_branding -%}
          <div class="cart-page__title cart-title">
            <h1>{{ 'content.your_cart_is_empty' | t }}</h1>
          </div>
        {%- endunless -%}
        <div class="cart-page__items">
          {% render 'cart-products', force_empty: true, context: cart_context, section_id: section.id, show_wishlist: section.settings.show_wishlist %}
        </div>
        {{ cart_page_more_blocks_content }}
      </div>
    </div>
  </template>

  <div class="section-background{% if custom_color %} color-custom-{{ section.id }}{% endif %}"></div>
  <div
    class="section{% if custom_color %} color-custom-{{ section.id }}{% endif %} section--{{ section.settings.section_width }}"
  >
    <div
      class="cart-page spacing-style{% if cart.empty? %} cart-page--empty{% endif %}"
      style="{% render 'spacing-style', settings: section.settings %}"
    >
      {%- unless settings.smelly_branding -%}
        <div class="cart-page__title">{{ cart_page_title }}</div>
      {%- endunless -%}

      <div class="cart-page__items">
        {%- content_for 'block', id: 'cart-page-items', type: '_cart-products' %}
      </div>

      {%- unless cart.empty? -%}
        <div class="cart-page__summary">
          {%- content_for 'block', id: 'cart-page-summary', type: '_cart-summary' -%}
        </div>
      {%- endunless -%}

      {{ cart_page_more_blocks_content }}
    </div>
  </div>

  {%- if section.settings.show_recommendations -%}
    {% render 'smelly-basket-recommendations', collection: section.settings.recommendation_collection, section_id: section.id %}
  {%- endif -%}
{% endcapture %}
{% render 'cart-items-component', children: cart_items_children, section_id: section.id %}

{% stylesheet %}
  .cart-page {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0 var(--padding-5xl);
  }

  .cart-page--empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .cart-page--empty .cart-page__title,
  .cart-page--empty .cart-page__more-blocks {
    margin-top: var(--margin-6xl);
  }

  .cart-page__more-blocks {
    width: 100%;
  }

  .cart-page--empty .cart-title {
    text-align: center;
  }

  .cart-page__main {
    grid-column: 1;
  }

  .cart-page__summary {
    padding-top: var(--padding-xl);
  }

  .cart-page__title + .cart-page__items {
    margin-block-start: var(--margin-lg);
  }

  @media screen and (min-width: 750px) {
    .cart-page {
      grid-template-columns: 1fr min(50vw, var(--sidebar-width));
      grid-template-rows: min-content min-content 1fr;
    }

    .cart-page__summary {
      display: grid;
      height: 100%;
      grid-column: 2;
      grid-row: 1 / -1;
      align-self: stretch;
      grid-template-rows: subgrid;
      padding-top: 0;

      /* needed to support blurred effect from hero section */
      position: relative;
    }

    .section--page-width .cart-page:has(.cart-summary--extend) {
      grid-column: 2 / 4;
      grid-template-columns: 1fr minmax(
          var(--sidebar-width),
          calc((100vw - var(--page-width)) / 2 + var(--sidebar-width))
        );
    }
  }

  @media screen and (min-width: 1400px) {
    .cart-page {
      grid-template-columns: 1fr var(--sidebar-width);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.cart",
  "class": "cart-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "text"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "button"
    },
    {
      "type": "video"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "number",
      "id": "free_uk_delivery_threshold",
      "label": "Free UK delivery threshold (£)",
      "info": "Match your Shopify UK shipping rate minimum in GBP. Leave blank to hide the progress bar.",
      "visible_if": "{{ settings.smelly_branding }}"
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Show Save for later",
      "default": true,
      "visible_if": "{{ settings.smelly_branding }}"
    },
    {
      "type": "checkbox",
      "id": "show_recommendations",
      "label": "Show basket recommendations",
      "default": true
    },
    {
      "type": "collection",
      "id": "recommendation_collection",
      "label": "Basket recommendation collection",
      "info": "Leave blank to suggest available products from your full catalogue."
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
