{% liquid
  assign about_link = section.settings.link | default: section.settings.page.url
  assign about_text = section.settings.text | strip_html | strip
  assign about_alt = 'smelly.photos.bubblegum' | t
  if section.settings.image != blank
    assign about_alt = section.settings.image_alt | default: shop.name
  endif
  assign image_loading = 'lazy'
  if section.index == 1 or section.index == 2
    assign image_loading = 'eager'
  endif
  assign has_copy = false
  if section.settings.note != blank or section.settings.heading != blank or about_text != blank
    assign has_copy = true
  endif
  if about_link != blank and section.settings.button_label != blank
    assign has_copy = true
  endif
%}

{% if has_copy or section.settings.image != blank or section.settings.caption != blank or request.design_mode %}
  <div class="smelly-about smelly-shell smelly-section-space{% unless has_copy %} smelly-about--photo-only{% endunless %}">
    {% if has_copy %}
      <div class="smelly-about__copy">
        {% if section.settings.note != blank %}
          <p class="smelly-handwritten">{{ section.settings.note | escape }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="smelly-about__heading">{{ section.settings.heading | escape | newline_to_br }}</h2>
        {% endif %}
        {% if about_text != blank %}
          <div class="smelly-about__text">{{ section.settings.text }}</div>
        {% endif %}
        {% if about_link != blank and section.settings.button_label != blank %}
          <a class="smelly-button" href="{{ about_link | escape }}">
            <span>{{ section.settings.button_label | escape }}</span><span aria-hidden="true">↗</span>
          </a>
        {% endif %}
      </div>
    {% endif %}

    <figure class="smelly-about__photo">
      <div class="smelly-about__frame">
        {% render 'smelly-photo',
          image: section.settings.image,
          fallback: 'smelly-pink-bubblegum.jpg',
          alt: about_alt,
          loading: image_loading,
          sizes: '(min-width: 1100px) 456px, (min-width: 750px) 40vw, (min-width: 500px) 436px, calc(100vw - 64px)'
        %}
      </div>
      {% if section.settings.caption != blank %}
        <figcaption class="smelly-about__caption">
          {% render 'smelly-illustration', kind: 'heart' %}
          <span class="smelly-handwritten">{{ section.settings.caption | escape }}</span>
        </figcaption>
      {% endif %}
    </figure>
  </div>
{% endif %}
{% schema %}
{
  "name": "Smelly A.F. about",
  "tag": "section",
  "class": "smelly-section smelly-about-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "note", "label": "Handwritten note", "default": "Hello, we’re Smelly A.F." },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "The little candle company\nwith a big A.F. personality." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Candles should smell brilliant and make you smile. That’s the idea behind Smelly A.F.: hand-poured soy wax, colourful candles and a playful streak.</p><p>From sweet-shop nostalgia to a little seasonal mischief, we’re here for the scents that feel like you. Pick your mood. Find your A.F.</p>" },
    { "type": "image_picker", "id": "image", "label": "Photograph" },
    { "type": "text", "id": "image_alt", "label": "Image description", "info": "Describe your uploaded photograph. Its own alt text takes priority; otherwise this description or the store name is used." },
    { "type": "text", "id": "caption", "label": "Photograph caption", "default": "A little jar. A lot of A.F." },
    { "type": "page", "id": "page", "label": "About page", "info": "Select your About page to show the button. No page is created automatically." },
    { "type": "url", "id": "link", "label": "Button link", "info": "Takes priority over the About page. Leave both links blank to hide the button." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "A little about us" }
  ],
  "presets": [{ "name": "Smelly A.F. about" }]
}
{% endschema %}
