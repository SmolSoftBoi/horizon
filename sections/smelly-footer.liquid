{% liquid
  assign newsletter_id = 'SmellyNewsletter-' | append: section.id
  assign newsletter_input_id = newsletter_id | append: '-email'
%}
<div class="smelly-footer">
  <div class="smelly-newsletter smelly-shell">
    <div><p class="smelly-handwritten">{{ section.settings.note | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.text | escape }}</p></div>
    {% form 'customer', id: newsletter_id, class: 'smelly-newsletter__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label for="{{ newsletter_input_id }}">{{ 'smelly.newsletter.email' | t }}</label>
      <div class="smelly-newsletter__input-row">
        <input id="{{ newsletter_input_id }}" type="email" name="contact[email]" value="{{ form.email | escape }}" autocomplete="email" autocorrect="off" autocapitalize="off" required {% if form.errors %}aria-invalid="true" aria-describedby="{{ newsletter_id }}-error"{% elsif form.posted_successfully? %}aria-describedby="{{ newsletter_id }}-success"{% endif %}>
        <button class="smelly-button" type="submit">{{ 'smelly.newsletter.subscribe' | t }}<span aria-hidden="true">↗</span></button>
      </div>
      {% if form.errors %}<div id="{{ newsletter_id }}-error" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
      {% if form.posted_successfully? %}<p id="{{ newsletter_id }}-success" role="status">{{ 'smelly.newsletter.success' | t }}</p>{% endif %}
      <p class="smelly-newsletter__consent">{{ 'smelly.newsletter.consent' | t }} {% if shop.privacy_policy.body != blank %}<a href="{{ shop.privacy_policy.url }}">{{ 'smelly.privacy_policy' | t }}</a>{% endif %}</p>
    {% endform %}
  </div>
  <div class="smelly-footer__main smelly-shell">
    <div class="smelly-footer__brand">
      <a href="{{ routes.root_url }}" aria-label="{{ 'smelly.home' | t }}">
        {% if settings.logo != blank %}
          {{ settings.logo | image_url: width: 400 | image_tag: class: 'smelly-footer__logo', width: 200, loading: 'lazy', alt: shop.name }}
        {% else %}
          {% render 'smelly-wordmark' %}
        {% endif %}
      </a>
      <p>{{ section.settings.tagline | escape }}</p>
    </div>
    <nav class="smelly-footer__nav" aria-label="{{ 'smelly.footer_navigation' | t }}">
      <h3>{{ 'smelly.explore' | t }}</h3><a href="{{ routes.all_products_collection_url }}">{{ 'smelly.shop_all' | t }}</a><a href="{{ routes.search_url }}">{{ 'smelly.search_scents' | t }}</a>
      {% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}
    </nav>
    <div class="smelly-footer__nav"><h3>{{ 'smelly.the_details' | t }}</h3>{% for policy in shop.policies %}{% if policy.body != blank %}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endif %}{% endfor %}
      {% if section.settings.contact_page != blank %}<a href="{{ section.settings.contact_page.url }}">{{ 'smelly.contact' | t }}</a>{% endif %}
    </div>
  </div>
  <div class="smelly-footer__bottom smelly-shell"><p>© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}.</p><span class="smelly-handwritten">{{ section.settings.signoff | escape }}</span>
    {% if section.settings.show_payment_icons %}<ul class="smelly-payments" role="list" aria-label="{{ 'smelly.payment_methods' | t }}">{% for type in shop.enabled_payment_types %}<li>{{ type | payment_type_svg_tag }}</li>{% endfor %}</ul>{% endif %}
  </div>
</div>
{% schema %}
{
  "name": "Smelly A.F. footer",
  "tag": "section",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "text", "id": "note", "label": "Handwritten note", "default": "Good emails. Good scents." },
    { "type": "text", "id": "heading", "label": "Newsletter heading", "default": "Stay in the scent loop." },
    { "type": "text", "id": "text", "label": "Newsletter text", "default": "New scents, seasonal moods and a little A.F. in your inbox." },
    { "type": "text", "id": "tagline", "label": "Brand tagline", "default": "Seriously good scents. A little less serious." },
    { "type": "link_list", "id": "menu", "label": "Footer menu", "default": "footer" },
    { "type": "page", "id": "contact_page", "label": "Contact page" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show enabled payment methods", "default": true },
    { "type": "text", "id": "signoff", "label": "Sign-off", "default": "Hand-poured. With A.F. attitude." }
  ],
  "presets": [{ "name": "Smelly A.F. footer" }]
}
{% endschema %}
