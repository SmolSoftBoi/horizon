<div class="smelly-shell smelly-section-space" id="SmellyRanges-{{ section.id }}">
  <div class="smelly-section-heading smelly-section-heading--centred">
    <p class="smelly-handwritten">{{ section.settings.note | escape }}</p><h2>{{ section.settings.heading | escape }}</h2>
    {% if section.settings.text != blank %}<p>{{ section.settings.text | escape }}</p>{% endif %}
  </div>
  <div class="smelly-range-grid">
    {% for block in section.blocks %}
      {% liquid
        assign range_collection = block.settings.collection
        assign range_url = range_collection.url | default: routes.all_products_collection_url
      %}
      <a class="smelly-range-card smelly-range-card--{{ block.settings.illustration }}" href="{{ range_url }}" {{ block.shopify_attributes }}>
        <div class="smelly-range-card__art">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 990px) 23vw, 45vw' }}{% else %}{% render 'smelly-illustration', kind: block.settings.illustration %}{% endif %}</div>
        <h3>{{ block.settings.heading | escape }}</h3><p>{{ block.settings.text | escape }}</p><span class="smelly-range-card__link">{{ 'smelly.explore_range' | t }} <span aria-hidden="true">↗</span></span>
      </a>
    {% endfor %}
  </div>
</div>
{% schema %}
{
  "name": "Smelly A.F. ranges",
  "tag": "section",
  "class": "smelly-section smelly-ranges-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "note", "label": "Handwritten note", "default": "Whatever your mood, there’s an A.F. for that." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your kind of A.F." },
    { "type": "text", "id": "text", "label": "Text", "default": "A little sweet, a little seasonal, a whole lot of personality." }
  ],
  "max_blocks": 4,
  "blocks": [{ "type": "range", "name": "Scent range", "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sweet A.F." },
    { "type": "text", "id": "text", "label": "Description", "default": "For your inner sweet tooth." },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Links to all products until a collection is selected." },
    { "type": "image_picker", "id": "image", "label": "Custom illustration" },
    { "type": "select", "id": "illustration", "label": "Illustration and colour", "options": [
      { "value": "pumpkin", "label": "Spooky — pumpkin" }, { "value": "festive", "label": "Festive — candy cane" }, { "value": "candy", "label": "Sweet — wrapped sweet" }, { "value": "flower", "label": "Fresh — flower" }
    ], "default": "candy" }
  ] }],
  "presets": [{ "name": "Smelly A.F. ranges", "blocks": [
    { "type": "range", "settings": { "heading": "Spooky A.F.", "text": "Cosy nights. Spooky season.", "illustration": "pumpkin" } },
    { "type": "range", "settings": { "heading": "Festive A.F.", "text": "A little extra festive feeling.", "illustration": "festive" } },
    { "type": "range", "settings": { "heading": "Sweet A.F.", "text": "For your inner sweet tooth.", "illustration": "candy" } },
    { "type": "range", "settings": { "heading": "Fresh A.F.", "text": "Fresh mood. Fresh start.", "illustration": "flower" } }
  ] }]
}
{% endschema %}
