{% liquid
  assign range_count = section.blocks.size
  assign explore_label = 'smelly.explore_range' | t
  assign image_sizes = '(min-width: 750px) 220px, (min-width: 464px) 180px, calc((100vw - 104px) / 2)'
  if range_count == 1
    assign image_sizes = '(min-width: 750px) 220px, 180px'
  endif
  assign image_loading = 'lazy'
  if section.index == 1 or section.index == 2
    assign image_loading = 'eager'
  endif
%}

{% if range_count > 0 or request.design_mode %}
  <div class="smelly-shell smelly-section-space" id="SmellyRanges-{{ section.id }}">
    {% if section.settings.note != blank or section.settings.heading != blank or section.settings.text != blank %}
      <div class="smelly-section-heading smelly-section-heading--centred smelly-ranges-heading">
        {% if section.settings.note != blank %}
          <p class="smelly-handwritten">{{ section.settings.note | escape }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% if section.settings.text != blank %}
          <p>{{ section.settings.text | escape }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% if range_count > 0 %}
      <ul
        class="smelly-range-grid"
        role="list"
        style="--smelly-range-columns: {{ range_count }}; --smelly-range-mobile-columns: {{ range_count | at_most: 2 }};"
      >
        {% for block in section.blocks %}
          {% liquid
            assign range_collection = block.settings.collection
            assign range_url = range_collection.url | default: routes.all_products_collection_url
            assign range_heading = block.settings.heading | default: range_collection.title | default: explore_label
          %}
          <li class="smelly-range-grid__item" {{ block.shopify_attributes }}>
            <a
              class="smelly-range-card smelly-range-card--{{ block.settings.illustration }}"
              href="{{ range_url }}"
              aria-labelledby="SmellyRangeLink-{{ section.id }}-{{ block.id }} SmellyRangeTitle-{{ section.id }}-{{ block.id }}"
            >
              <div class="smelly-range-card__art" aria-hidden="true">
                <div class="smelly-range-card__illustration">
                  {% if block.settings.image != blank %}
                    {{
                      block.settings.image
                      | image_url: width: 480
                      | image_tag: loading: image_loading, alt: '', widths: '160, 240, 360, 480', sizes: image_sizes
                    }}
                  {% else %}
                    {% render 'smelly-illustration', kind: block.settings.illustration %}
                  {% endif %}
                </div>
              </div>
              <h3 id="SmellyRangeTitle-{{ section.id }}-{{ block.id }}">{{ range_heading | escape }}</h3>
              {% if block.settings.text != blank %}
                <p class="smelly-range-card__description">{{ block.settings.text | escape }}</p>
              {% endif %}
              <span class="smelly-range-card__link" id="SmellyRangeLink-{{ section.id }}-{{ block.id }}">
                <span>{{ explore_label }}</span>
                <span class="smelly-range-card__arrow" aria-hidden="true">↗</span>
              </span>
            </a>
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
{% endif %}
{% schema %}
{
  "name": "Smelly A.F. ranges",
  "tag": "section",
  "class": "smelly-section smelly-ranges-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "note", "label": "Handwritten note", "default": "Whatever your mood, there’s an A.F. for that." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your kind of A.F." },
    { "type": "text", "id": "text", "label": "Text", "default": "A little sweet, a little seasonal, a whole lot of personality." }
  ],
  "max_blocks": 4,
  "blocks": [{ "type": "range", "name": "Scent range", "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sweet A.F." },
    { "type": "text", "id": "text", "label": "Description", "default": "For your inner sweet tooth." },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Links to all products until a collection is selected." },
    { "type": "image_picker", "id": "image", "label": "Custom illustration" },
    { "type": "select", "id": "illustration", "label": "Illustration and colour", "options": [
      { "value": "pumpkin", "label": "Spooky — pumpkin" }, { "value": "festive", "label": "Festive — candy cane" }, { "value": "candy", "label": "Sweet — wrapped sweet" }, { "value": "flower", "label": "Fresh — flower" }
    ], "default": "candy" }
  ] }],
  "presets": [{ "name": "Smelly A.F. ranges", "blocks": [
    { "type": "range", "settings": { "heading": "Spooky A.F.", "text": "Cosy nights. Spooky season.", "illustration": "pumpkin" } },
    { "type": "range", "settings": { "heading": "Festive A.F.", "text": "A little extra festive feeling.", "illustration": "festive" } },
    { "type": "range", "settings": { "heading": "Sweet A.F.", "text": "For your inner sweet tooth.", "illustration": "candy" } },
    { "type": "range", "settings": { "heading": "Fresh A.F.", "text": "Fresh mood. Fresh start.", "illustration": "flower" } }
  ] }]
}
{% endschema %}
