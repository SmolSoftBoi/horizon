{% if section.settings.blog.articles_count > 0 or request.design_mode %}
  <div class="smelly-shell smelly-section-space">
    <div class="smelly-section-heading"><div><p class="smelly-handwritten">{{ section.settings.note | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div>
      {% if section.settings.blog != blank %}<a class="smelly-text-link" href="{{ section.settings.blog.url }}">{{ 'smelly.read_journal' | t }}<span aria-hidden="true">↗</span></a>{% endif %}
    </div>
    <div class="smelly-journal-grid">
      {% for article in section.settings.blog.articles limit: 3 %}
        <article class="smelly-journal-card">
          {% if article.image != blank %}<a class="smelly-journal-card__image" href="{{ article.url }}">{{ article.image | image_url: width: 900 | image_tag: widths: '300, 450, 600, 900', sizes: '(min-width: 750px) 30vw, 90vw', loading: 'lazy' }}</a>{% endif %}
          <h3><a href="{{ article.url }}">{{ article.title | escape }}</a></h3>
          <p>{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</p>
          <a class="smelly-text-link" href="{{ article.url }}">{{ 'smelly.read_story' | t }}<span class="visually-hidden">: {{ article.title | escape }}</span><span aria-hidden="true">↗</span></a>
        </article>
      {% else %}
        <p class="smelly-editor-note">{{ 'smelly.editor.journal' | t }}</p>
      {% endfor %}
    </div>
  </div>
{% endif %}
{% schema %}
{
  "name": "Smelly A.F. journal",
  "tag": "section",
  "class": "smelly-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "note", "label": "Handwritten note", "default": "Notes from our little candle corner" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A little light reading." },
    { "type": "blog", "id": "blog", "label": "Blog", "info": "This section only appears to shoppers when the selected blog has articles." }
  ],
  "presets": [{ "name": "Smelly A.F. journal" }]
}
{% endschema %}
